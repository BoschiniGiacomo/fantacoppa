{
  "expo": {
    "name": "FantaCoppa",
    "slug": "fantacoppa",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "assets/**/*",
      "uploads/app_loading/**/*",
      "uploads/login_background/**/*",
      "uploads/login_logo/**/*",
      "uploads/match_background/**/*",
      "uploads/official_group_logos/**/*",
      "uploads/official_team_logos/**/*",
      "uploads/player_photos/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fantacoppa.app",
      "buildNumber": "18",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fantacoppa.app",
      "versionCode": 18,
      "googleServicesFile": "./google-services.json",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-android-adaptive.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "appVersionCode": 18,
      "supabaseUrl": "https://zaqvtlsmefrgbduhzmwk.supabase.co",
      "eas": {
        "projectId": "f1e19392-b5b0-4646-8672-5f8e39654f4a"
      }
    },
    "owner": "boscojack02",
    "runtimeVersion": "1.0.13",
    "updates": {
      "url": "https://u.expo.dev/f1e19392-b5b0-4646-8672-5f8e39654f4a",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "./plugins/with-android-splash-no-logo",
      "./plugins/with-android-r8-minify",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "mode": "production",
          "enableBackgroundRemoteNotifications": true,
          "defaultChannel": "fantacoppa-reminders",
          "color": "#667eea"
        }
      ],
      "expo-video",
      "expo-sharing"
    ]
  }
}
