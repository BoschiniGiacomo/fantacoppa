{
  "expo": {
    "name": "FantaCoppa",
    "slug": "fantacoppa",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fantacoppa.app",
      "buildNumber": "12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fantacoppa.app",
      "versionCode": 13,
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "appVersionCode": 13,
      "supabaseUrl": "https://zaqvtlsmefrgbduhzmwk.supabase.co",
      "eas": {
        "projectId": "f1e19392-b5b0-4646-8672-5f8e39654f4a"
      }
    },
    "owner": "boscojack02",
    "runtimeVersion": "1.0.10",
    "updates": {
      "url": "https://u.expo.dev/f1e19392-b5b0-4646-8672-5f8e39654f4a",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "mode": "production",
          "enableBackgroundRemoteNotifications": true,
          "defaultChannel": "fantacoppa-reminders",
          "color": "#667eea"
        }
      ],
      "expo-video"
    ]
  }
}
