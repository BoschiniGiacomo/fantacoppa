{
  "name": "fantacoppa-mobile",
  "version": "1.0.13",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "prestart": "node fix-node-sea.js && node scripts/generateBundledUploadsManifest.js",
    "generate:uploads-manifest": "node scripts/generateBundledUploadsManifest.js",
    "dedupe:uploads": "node scripts/dedupeUploadsMedia.js",
    "dedupe:uploads:db": "node scripts/dedupeUploadsMedia.js --db",
    "sync:uploads:supabase": "node scripts/syncUploadsToSupabase.js",
    "pull:uploads:supabase": "node scripts/pullUploadsFromSupabase.js",
    "update:uploads:production": "node scripts/updateBundledUploadsFromSupabase.js",
    "update:uploads:preview": "node scripts/updateBundledUploadsFromSupabase.js --preview",
    "prepare:media-release": "node scripts/dedupeUploadsMedia.js --db && node scripts/syncUploadsToSupabase.js",
    "start": "expo start",
    "start:clean": "expo start -c",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:apk:prod": "eas build --platform android --profile production-apk",
    "build:android:aab": "eas build --platform android --profile production",
    "build:list": "eas build:list",
    "build:download": "eas build:download",
    "update:preview": "eas update --channel preview --message",
    "update:production": "eas update --channel production --message",
    "icons:android-adaptive": "node scripts/build-android-adaptive-icon.js",
    "refresh:official-absolute-stats": "node scripts/refreshOfficialGroupAbsoluteStats.js",
    "backup:db": "node scripts/backupDatabase.js",
    "backup:db:mysql": "node scripts/backupDatabase.js --dialect=mysql",
    "backup:db:full": "node scripts/backupDatabase.js --full"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.11.0",
    "axios": "^1.6.2",
    "expo": "~57.0.25",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1313.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "babel-preset-expo": "~57.0.0"
  },
  "overrides": {
    "react-native-safe-area-context": "~5.7.0",
    "minimatch@10.1.1": "10.2.5",
    "minimatch@9.0.9": {
      "brace-expansion": "2.0.3"
    }
  },
  "private": true
}
